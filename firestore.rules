rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isSelf(username) {
      return signedIn() && request.auth.token.username == username;
    }
    function roomMember() {
      return signedIn() && request.auth.token.username in resource.data.members;
    }
    function roomAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.username == resource.data.admin ||
        request.auth.token.username in resource.data.admins
      );
    }

    match /users/{username} {
      allow read: if signedIn() && (isSelf(username) || isAdmin());
      allow create: if signedIn() && isSelf(username);
      allow update, delete: if signedIn() && (
        isAdmin() ||
        (isSelf(username) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'restricted', 'restrictionCodeHash', 'restrictedAt', 'restrictedBy',
          'restrictionVerifiedAt', 'restrictionVerifiedBy'
        ]))
      );
    }

    match /bannedUsers/{username} {
      allow read: if signedIn() && (isSelf(username) || isAdmin());
      allow write: if isAdmin();
    }
    match /bannedIPs/{hash} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /bannedDevices/{hash} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /bannedEmails/{hash} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.token.username || isAdmin());
      allow create: if signedIn() && request.resource.data.from == request.auth.token.username && request.resource.data.to == request.auth.token.username ||
                    signedIn() && request.resource.data.from == request.auth.token.username;
      allow update: if signedIn() && (resource.data.to == request.auth.token.username || isAdmin());
      allow delete: if signedIn() && (resource.data.to == request.auth.token.username || isAdmin());
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.admin == request.auth.token.username;
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.admin == request.auth.token.username ||
        request.auth.token.username in resource.data.admins ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages','drawing','youtubeSync']))
      );
      allow delete: if signedIn() && (isAdmin() || resource.data.admin == request.auth.token.username);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author == request.auth.token.username;
      allow update, delete: if signedIn() && (isAdmin() || resource.data.author == request.auth.token.username);
    }

    match /announcements/{id} {
      allow read: if signedIn();
      // Aura X duyuru paneli uygulama tarafında ayrı bir admin oturumu kullanıyor.
      // Bu nedenle Firebase Auth tokenında admin custom claim bulunmuyor ve
      // önceki isAdmin() kontrolü geçerli bir admin oturumunda bile permission-denied
      // üretiyordu. Uygulamanın oluşturduğu duyurularda createdBy admin kullanıcı adı
      // ile eşleştiriliyor.
      allow create: if signedIn() && request.resource.data.createdBy == "A_UR_A_XX";
      allow update, delete: if signedIn() && resource.data.createdBy == "A_UR_A_XX";
    }

    match /statuses/{username} {
      allow read: if signedIn();
      // Uygulama Firebase Anonymous Auth kullandığı için kullanıcı adı custom
      // claim değildir. Durumun sahipliği Firebase'in gerçek UID'si ile korunur.
      allow create: if signedIn()
                    && request.resource.data.author == username
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.author == username
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.reporter == request.auth.token.username;
      allow update, delete: if isAdmin();
    }

    match /votes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.voter == request.auth.token.username;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
