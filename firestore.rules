rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Aura X'nin mevcut mimarisinde uygulama kullanıcı adı/şifreyi kendi
    // users dokümanında tutuyor; Firebase Auth ise oturum taşıyıcısı olarak
    // kullanılıyor. Bu yüzden custom username claim'i şart koşulmamalı.
    // Admin işlemlerinin asıl ekran kontrolü index.html içindeki admin oturumudur.
    // Gerçek production güvenliği için admin custom claim/backend tercih edilir.
    function isAdmin() {
      return signedIn() &&
        request.resource.data.admin == true;
    }

    match /users/{username} {
      // Kullanıcı adıyla giriş için oturum açmış istemcinin kullanıcı belgelerini
      // okuyabilmesi gerekiyor.
      allow read: if signedIn();

      // Yeni kayıt Google ile doğrulanmış Firebase oturumu üzerinden oluşturulur.
      allow create: if signedIn()
                    && request.resource.data.googleUid == request.auth.uid;

      // Kullanıcı kendi belgesindeki normal profil/aktivite alanlarını güncelleyebilir.
      // Kısıtlama/ban alanlarını istemci kullanıcı değiştiremez.
      allow update: if signedIn()
                    && resource.data.googleUid == request.auth.uid
                    && request.resource.data.googleUid == resource.data.googleUid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'restricted', 'restrictionCodeHash', 'restrictedAt', 'restrictedBy',
                      'banned', 'bannedAt', 'bannedBy'
                    ]);

      allow delete: if false;
    }

    match /bannedUsers/{username} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /bannedIPs/{hash} {
      // İstemcinin giriş sırasında kendi IP hash'ini kontrol edebilmesi gerekir.
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /bannedDevices/{hash} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /bannedEmails/{hash} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /notifications/{id} {
      allow read, create, update, delete: if signedIn();
    }

    match /rooms/{roomId} {
      allow read, create, update, delete: if signedIn();
    }

    match /posts/{postId} {
      allow read, create, update, delete: if signedIn();
    }

    match /announcements/{id} {
      allow read, create, update, delete: if signedIn();
    }

    match /statuses/{username} {
      allow read, create, update, delete: if signedIn();
    }

    match /reports/{id} {
      // Hem manuel hem otomatik yaş filtresi raporlarının oluşturulabilmesi gerekir.
      allow read, create, update, delete: if signedIn();
    }

    match /votes/{id} {
      allow read, create, update, delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
