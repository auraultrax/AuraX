rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/A_UR_A_XX)
        && get(/databases/$(database)/documents/users/A_UR_A_XX).data.googleUid == request.auth.uid;
    }
    function currentUsername() {
      return get(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.username;
    }

    match /accountLinks/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/accountLinks/$(uid))
                    && request.resource.data.googleUid == uid
                    && request.resource.data.username is string;
      allow update, delete: if false;
    }

    match /users/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.googleUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/accountLinks/$(request.auth.uid)).data.username == username;
      allow update: if isSystemAdmin()
                    || (signedIn() && request.resource.data.banned == true && request.resource.data.bannedBy == 'A_UR_A_XX')
                    || (signedIn() && request.resource.data.restricted == true && request.resource.data.restrictedBy == 'A_UR_A_XX')
                    || (signedIn() && resource.data.googleUid == request.auth.uid
                        && request.resource.data.googleUid == resource.data.googleUid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'restricted','restrictionCodeHash','restrictedAt','restrictedBy',
                          'banned','bannedAt','bannedBy'
                        ]));
      allow delete: if isSystemAdmin();
    }

    match /restrictions/{username} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.restrictedBy == 'A_UR_A_XX';
      allow delete: if isSystemAdmin();
    }

    match /bannedUsers/{username} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.bannedBy == 'A_UR_A_XX';
    }
    match /bannedIPs/{hash} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.bannedBy == 'A_UR_A_XX';
    }
    match /bannedDevices/{hash} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.bannedBy == 'A_UR_A_XX';
    }
    match /bannedEmails/{hash} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.bannedBy == 'A_UR_A_XX';
    }
    match /notifications/{id} {
      allow read, create, update, delete: if signedIn();
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn();

      // Oda kurucusu / yardımcı yöneticiler / sistem yöneticisi; oda ayarlarını
      // (kilit, Çizim, YouTube, yöneticiler vb.) değiştirebilir.
      allow update: if signedIn() && (
        isSystemAdmin()
        || resource.data.admin == currentUsername()
        || (resource.data.admins is list && resource.data.admins.hasAny([currentUsername()]))
        || (
          resource.data.members is list
          && request.resource.data.members is list
          && resource.data.members.hasAny([currentUsername()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'messages','members','drawing','youtubeQueue','youtubeCurrentIndex','youtubeSync'
          ])
          && (
            // Yeni üye yalnızca kendisini odaya ekleyebilir.
            (request.resource.data.members.size() == resource.data.members.size() + 1
              && request.resource.data.members.hasAll(resource.data.members)
              && request.resource.data.members.hasAny([currentUsername()]))
            // Odaya girmiş üye yalnızca kendi üyeliğini sonlandırabilir.
            || (request.resource.data.members.size() == resource.data.members.size() - 1
              && resource.data.members.hasAny([currentUsername()])
              && resource.data.members.hasAll(request.resource.data.members)
              && !request.resource.data.members.hasAny([currentUsername()]))
            // Mesaj/çizim/YouTube senkronu gibi normal oda işlemleri.
            || request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'messages','drawing','youtubeQueue','youtubeCurrentIndex','youtubeSync'
            ])
          )
        )
      );

      // Oda silme: kurucu veya sistem yöneticisi. Soft-delete yok; doküman doğrudan silinir.
      allow delete: if signedIn() && (
        isSystemAdmin()
        || (resource.data.ownerUid is string && resource.data.ownerUid == request.auth.uid)
        || resource.data.admin == currentUsername()
      );
    }
    match /posts/{postId} { allow read, create, update, delete: if signedIn(); }
    match /announcements/{id} { allow read, create, update, delete: if signedIn(); }
    match /statuses/{username} { allow read, create, update, delete: if signedIn(); }
    match /reports/{id} { allow read, create, update, delete: if signedIn(); }
    match /votes/{id} { allow read, create, update, delete: if signedIn(); }

    match /{document=**} { allow read, write: if false; }
  }
}
