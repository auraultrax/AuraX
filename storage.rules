rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Aura X şu anda Firebase Anonymous Auth ile oturum açıyor.
    // Bu nedenle request.auth != null, uygulamadaki oturum açılmış
    // kullanıcıyı temsil eder. Dosya türü ve boyutu burada da zorunlu tutulur.

    match /announcements/{fileName} {
      // Duyuru videoları uygulama tarafından indirme URL'si ile oynatılır.
      allow read: if request.auth != null;

      // Uygulamadaki duyuru yükleme ekranı yalnızca admin'e gösterilir.
      // Ayrıca Storage tarafında boyut/tür kontrolü yapılır.
      allow create: if request.auth != null
                    && request.resource.size <= 50 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');

      allow update: if false;
      allow delete: if false;
    }

    match /postVideos/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.size <= 50 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');

      allow update: if false;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
